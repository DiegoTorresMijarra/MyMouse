<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema de todas las pantallas (docs/spec-v4.5-estilo.md §3): sin ActionBar, fondo degradado, acento y barras transparentes.
         Sin Material Components ni AppCompat: solo temas de la plataforma. -->
    <style name="Theme.MyMouse" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/glass_background</item>
        <item name="android:colorAccent">@color/glass_accent</item>
        <item name="android:colorControlActivated">@color/glass_accent</item>
        <item name="android:textColorPrimary">@color/glass_text</item>
        <item name="android:textColorSecondary">@color/glass_text_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:alertDialogTheme">@style/Theme.MyMouse.Dialog</item>
    </style>

    <style name="Theme.MyMouse.Dialog" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:windowBackground">@drawable/glass_dialog_background</item>
        <item name="android:colorAccent">@color/glass_accent</item>
        <item name="android:textColorPrimary">@color/glass_text</item>
        <item name="android:textColorSecondary">@color/glass_text_secondary</item>
    </style>
</resources>
