<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- El mismo fichero que lee el test de Kotlin: coordenadas de las 15 formas del catálogo. -->
    <None Include="..\..\..\android\core\src\test\resources\shape-catalog.txt" Link="shape-catalog.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Respuesta realista de la API de GitHub (releases): la comprueban también los tests de Kotlin (docs/spec-v5.1-actualizaciones.md §3). -->
    <None Include="..\..\..\android\core\src\test\resources\github-releases.json" Link="github-releases.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- La fuente compartida de los temas (docs/spec-v4.8-temas.md §4): el móvil la lee en ThemesFixtureTest. -->
    <None Include="..\..\..\shared\themes.json" Link="themes.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MyMouse.HostCore\MyMouse.HostCore.csproj" />
  </ItemGroup>

</Project>