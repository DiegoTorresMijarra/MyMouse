<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041: proyección de las API WinRT (sesiones multimedia) para el widget de música. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- WPF para las ventanas (toolbox, gesto en vivo, editor); WinForms solo para NotifyIcon (icono de la bandeja). -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MyMouse</AssemblyName>
    <!-- La versión de la app (docs/spec-v5.1-actualizaciones.md §3): CI la pasa con -p:Version y -p:InformationalVersion (5.0 en una release,
         0.0-dev.N en las demás). Una compilación local es de desarrollo y no avisa de versiones nuevas. -->
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">0.0-dev</InformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icono de la app (docs/spec-v4.7-universo.md §3.3): lo genera tools/icon/make_icons.py. -->
    <ApplicationIcon>Assets\MyMouse.ico</ApplicationIcon>
    <!-- La escala por monitor (PerMonitorV2) se declara en app.manifest, que es lo que usa WPF; el analizador de WinForms
         prefiere su propia propiedad, que aquí no se usa (no hay Application.Run de WinForms). -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <!-- WPF + WinForms autocontenidos pesan ~200 MB en un solo fichero: se comprime (solo afecta a "dotnet publish" de un solo fichero). -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Con las dos plataformas, los usings implícitos de WinForms chocan con los de WPF (Application, Button, Color…). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- UseWPF quita System.IO de los usings implícitos (choca con System.Windows.Shapes.Path). -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <!-- El mismo .ico, dentro del ensamblado, para Window.Icon y los iconos de la bandeja. -->
    <EmbeddedResource Include="Assets\MyMouse.ico" LogicalName="MyMouse.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MyMouse.HostCore\MyMouse.HostCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
  </ItemGroup>
</Project>
